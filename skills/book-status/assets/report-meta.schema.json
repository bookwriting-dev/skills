{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storycraft review metadata v1",
  "type": "object",
  "required": ["schema_version", "report", "report_sha256", "inputs", "verdict"],
  "properties": {
    "schema_version": {"const": 1},
    "report": {"type": "string", "minLength": 1},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verdict": {"enum": ["PASS", "WARN", "FAIL"]},
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "kind"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"enum": ["file", "directory"]},
          "sha256": {"type": ["string", "null"]},
          "files": {"type": "object"}
        }
      }
    },
    "findings": {
      "type": "array", "items": {
        "type": "object", "required": ["id", "blocking"],
        "properties": {"id": {"type": "string"}, "blocking": {"type": "boolean"}}
      }
    }
  }
}
